{
  "name": "roleros",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Roleros — app de campaña (PF1e · Ustalav): fichas con revelado, cuestionario y panel de máster. Web + APK con Capacitor.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "sync": "npm run build && npx cap sync android",
    "open:android": "npx cap open android",
    "apk": "npm run build && npx cap sync android && android\\gradlew.bat -p android assembleDebug",
    "sql": "node --env-file=.env scripts/sql.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-router": "^1.170.46",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@capacitor/android": "^7.6.10",
    "@capacitor/cli": "^7.6.10",
    "@capacitor/core": "^7.6.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^6.4.6"
  }
}
